{
  "name": "nuxeo-coldstorage-web",
  "description": "Nuxeo Cold Storage WebUI integration",
  "author": "Nuxeo",
  "license": "Apache-2.0",
  "devDependencies": {
    "@nuxeo/nuxeo-web-ui-ftest": "~3.1.30",
    "expect-webdriverio": "^5.6.7",
    "@open-wc/eslint-config": "^0.4.5",
    "@esm-bundle/chai": "^4.1.5",
    "@nuxeo/testing-helpers": "~3.1.30",
    "@rollup/plugin-node-resolve": "^7.1.3",
    "@web/dev-server-legacy": "^0.1.7",
    "@web/test-runner": "^0.20.2",
    "@web/test-runner-playwright": "^0.11.1",
    "@web/test-runner-saucelabs": "^0.13.0",
    "eslint": "^7.12.1",
    "eslint-config-airbnb-base": "^14.2.0",
    "eslint-config-prettier": "^6.15.0",
    "eslint-plugin-html": "^6.1.0",
    "eslint-plugin-import": "^2.22.1",
    "husky": "^4.3.0",
    "lint-staged": "^10.5.1",
    "prettier": "2.1.2",
    "rollup": "^2.80.0",
    "rollup-plugin-copy": "^3.3.0",
    "rollup-plugin-minify-html-literals": "^1.2.5",
    "rollup-plugin-terser": "^7.0.2",
    "wdio-cucumberjs-json-reporter": "6.0.1"
  },
  "dependencies": {
    "@nuxeo/nuxeo-elements": "~3.1.30",
    "@nuxeo/nuxeo-ui-elements": "~3.1.30",
    "@polymer/iron-icon": "^3.0.0",
    "@polymer/iron-icons": "^3.0.1",
    "@polymer/iron-iconset-svg": "^3.0.1",
    "@polymer/paper-button": "^3.0.0",
    "@polymer/paper-icon-button": "^3.0.0",
    "@polymer/polymer": "3.3.1",
    "nuxeo": "^3.18.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,html}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "overrides": {
    "babel-traverse": "npm:@babel/traverse@^7.23.2",
    "browserslist-useragent": "^4.0.0",
    "diff": "^8.0.3",
    "flatted": ">=3.4.2",
    "html-minifier": "npm:html-minifier-terser@7.2.0",
    "json5": "1.0.2",
    "moment": "2.30.1",
    "serialize-javascript": ">=7.0.5",
    "tmp": "0.2.4",
    "useragent": "2.3.0",
    "yargs-parser": "21.1.1"
  },
  "scripts": {
    "build": "rollup -c",
    "lint": "npm run lint:eslint && npm run lint:prettier",
    "lint:eslint": "eslint . --ext .js,.mjs,.html",
    "lint:prettier": "prettier \"**/*.{js,mjs,html}\" --check || (echo '↑↑ these files are not prettier formatted ↑↑' && exit 1)",
    "format": "npm run format:prettier && npm run format:eslint",
    "format:eslint": "eslint --ext .js,.mjs,.html . --fix",
    "format:prettier": "prettier \"**/*.{js,mjs,html}\" --write",
    "test": "web-test-runner",
    "test:watch": "web-test-runner --watch",
    "ftest": "cd ftest && nuxeo-web-ui-ftest --screenshots --report --headless",
    "ftest:watch": "cd ftest && nuxeo-web-ui-ftest --debug --tags=@watch"
  }
}
